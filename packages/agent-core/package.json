{
  "name": "@rye/agent-core",
  "version": "0.1.0",
  "private": true,
  "description": "Rye production support agent — core (pi-ai, Bun, Hono)",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --sourcemap=external",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "@aws-sdk/client-cloudwatch-logs": "^3.700.0",
    "@aws-sdk/client-ec2": "^3.1033.0",
    "@aws-sdk/client-ecs": "^3.1033.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1033.0",
    "@aws-sdk/client-rds": "^3.1033.0",
    "@aws-sdk/client-s3": "^3.1033.0",
    "@earendil-works/pi-ai": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@rye/shared": "workspace:*",
    "allo-font": "1.0.1",
    "docx": "^9.15.0",
    "hono": "^4.6.0",
    "marked": "^18.1.2",
    "mysql2": "^3.11.0",
    "simple-git": "^3.27.0",
    "smol-toml": "^1.3.0",
    "typebox": "1.3.27",
    "yaml": "^2.9.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.3"
  }
}

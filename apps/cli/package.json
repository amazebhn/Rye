{
  "name": "@rye/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Rye production support agent — CLI",
  "type": "module",
  "bin": {
    "rye": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun build src/index.ts --outdir dist --target bun --sourcemap=external --watch",
    "build": "bun build src/index.ts --outdir dist --target bun --sourcemap=external",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@rye/shared": "workspace:*",
    "chalk": "^5.3.0",
    "ora": "^8.1.1",
    "inquirer": "^12.3.0",
    "eventsource-parser": "^3.0.0",
    "commander": "^13.1.0",
    "conf": "^13.1.0",
    "smol-toml": "^1.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3"
  }
}
